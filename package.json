{
  "name": "html2design",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc -b packages/ir packages/serializer packages/reference-renderer packages/bundle packages/plugin",
    "typecheck:root": "tsc -p tsconfig.json",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test": "pnpm typecheck && pnpm typecheck:root && pnpm test:unit && pnpm test:e2e",
    "build:serializer": "pnpm --filter @h2d/serializer build",
    "capture": "node scripts/capture.mjs",
    "build:bundle": "pnpm --filter @h2d/bundle build",
    "build:plugin": "pnpm --filter @h2d/plugin build"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.138.0",
    "@h2d/ir": "workspace:*",
    "@h2d/reference-renderer": "workspace:*",
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.7.0",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "pixelmatch": "^6.0.0",
    "pngjs": "^7.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "fflate": "^0.8.3"
  }
}
